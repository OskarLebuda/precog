{
  "name": "nuxt-precog",
  "version": "0.3.0",
  "description": "Renamed to @precog/nuxt. This package re-exports it so existing installs keep working.",
  "keywords": [
    "deprecated",
    "nuxt",
    "nuxt-module"
  ],
  "homepage": "https://oskarlebuda.github.io/precog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OskarLebuda/precog.git",
    "directory": "packages/nuxt-precog"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "mkdir -p dist && cp src/module.mjs dist/module.mjs && cp src/module.d.mts dist/module.d.mts",
    "prepack": "pnpm build",
    "typecheck": "exit 0"
  },
  "dependencies": {
    "@precog/nuxt": "workspace:*"
  }
}
