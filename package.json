{
  "name": "precog-monorepo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter @precog/nuxt dev",
    "dev:prepare": "pnpm --filter @precog/core build && pnpm --filter @precog/nuxt dev:prepare",
    "fmt": "oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest dev",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @precog/nuxt test:e2e",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "bench": "node bench/run.mjs",
    "docs:dev": "pnpm --filter nuxt-precog-docs dev",
    "docs:build": "pnpm --filter nuxt-precog-docs build"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "changelogen": "^0.6.2",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@10.28.0"
}
